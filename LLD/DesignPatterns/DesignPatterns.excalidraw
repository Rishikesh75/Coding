      "link": null,
      "locked": false,
      "text": "If the Class has 5+ Parameters and you need to set this Datamembers incremnetally then we use Builder Pattern.\nWe Define the Builder as static so we can avoid new Product during every product creation\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the Class has 5+ Parameters and you need to set this Datamembers incremnetally then we use Builder Pattern.\nWe Define the Builder as static so we can avoid new Product during every product creation\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
